# Deny-by-default: this repo tracks the literate config, the init files, and
# the elisp libraries of mylibs/.  Everything else in ~/.emacs.d is runtime
# state, package installs, backups, or credentials — none of it should ever be
# committed by an `git add -A`.
*

# --- explicitly tracked ---
!.gitignore
!early-init.el
!init.el
!emacs26.org
!misc.org
!orgmode.org

# mylibs/ is tracked normally: a new library must not need `git add -f'.
# The directory itself has to be re-included before anything inside it can be,
# `*' above matching it too — git does not descend into an excluded directory.
# Only sources, never the .elc that byte-compilation drops beside them.
!mylibs/
!mylibs/*.el
!mylibs/.gitignore

# --- never track, even if the rules above are relaxed later ---
# (redundant with `*`, kept as an explicit guard)
backups/
var/backup/
auto-save-list/
kraken.el
emacsstorre.org
oauth2-auto.plist
*.gpg
.authinfo*
history
recentf
forge-database*.sqlite
org-roam.db
projectile.cache
network-security.data
